@model G6_BevoTunes.Models.OrderDetail

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>OrderDetail</h4>
    <hr />
    <dl class="row">
        @if (Model.Song != null)
        {
            <dt class = "col-sm-2">
                <b>Song: </b>
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Song.SongTitle)
            </dd>
        }
        else if (Model.Album != null)
        {
            <dt class = "col-sm-2">
                <b>Album: </b>
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Album.AlbumName)
            </dd>
        }
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PurchasedPrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PurchasedPrice)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="OrderDetailID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Details" asp-controller="Orders" asp-route-id="@Model.Order.OrderID">Back to Cart</a>   
    </form>
</div>
