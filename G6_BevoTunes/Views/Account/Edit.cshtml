@model G6_BevoTunes.Models.EditViewModel

<h2>Edit Profile</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="UserID" />

    <h4>Personal Information</h4>
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <hr />
    <h4>Security</h4>
    <div class="alert alert-info">Only fill these out if you want to change your password.</div>
    <div class="form-group">
        <label>Current Password</label>
        <input asp-for="OldPassword" class="form-control" />
    </div>
    <div class="form-group">
        <label>New Password</label>
        <input asp-for="NewPassword" class="form-control" />
    </div>

    <hr />
    <h4>Payment Methods</h4>
    <div class="form-group">
        <label asp-for="CardNumber1"></label>
        <input asp-for="CardNumber1" class="form-control" placeholder="15 or 16 digits" />
    </div>
    <div class="form-group">
        <label asp-for="CardNumber2"></label>
        <input asp-for="CardNumber2" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
