@model G6_BevoTunes.Models.UserIndexViewModel

@{
    ViewData["Title"] = "User Directory";
}

<div class="mb-4">
    <a asp-action="CreateCustomer" asp-controller="Account" class="btn btn-success">
        + Create New Customer Profile
    </a>
</div>

<h1>User Directory</h1>

@* TAB HEADERS (Unchanged) *@
<ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pills-customers-tab" data-bs-toggle="pill" data-bs-target="#pills-customers"
                type="button" role="tab" aria-controls="pills-customers" aria-selected="true">
            Customers <span class="badge badge-info">@Model.Customers.Count()</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-employees-tab" data-bs-toggle="pill" data-bs-target="#pills-employees"
                type="button" role="tab" aria-controls="pills-employees" aria-selected="false">
            Employees <span class="badge badge-info">@Model.Employees.Count()</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-managers-tab" data-bs-toggle="pill" data-bs-target="#pills-managers"
                type="button" role="tab" aria-controls="pills-managers" aria-selected="false">
            Managers <span class="badge badge-info">@Model.Managers.Count()</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="pills-tabContent">
    
    @* CUSTOMERS TAB *@
    <div class="tab-pane fade show active" id="pills-customers" role="tabpanel" aria-labelledby="pills-customers-tab">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>First Name</th><th>Last Name</th><th>Email</th><th>Phone</th>
                    <th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Customers)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>
                            @* Rubric: Disabled customers can log in, but not checkout *@
                            @if (item.LockoutEnabled ==false)
                            {
                                <span class="badge bg-warning text-dark">Disabled (No Checkout)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-controller="Account" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Modify</a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline">
                                <button type="submit" class="btn @(item.LockoutEnabled ? "btn-outline-success" : "btn-danger") btn-sm">
                                    @(item.LockoutEnabled ? "Disable" : "Enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* EMPLOYEES TAB *@
    <div class="tab-pane fade" id="pills-employees" role="tabpanel" aria-labelledby="pills-employees-tab">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>First Name</th><th>Last Name</th><th>Email</th><th>Phone</th>
                    <th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Employees)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>
                            @* Rubric: Fired employees are blocked from logging in *@
                            @if (item.LockoutEnd != null && item.LockoutEnd > DateTime.Now)
                            {
                                <span class="badge bg-dark text-white">Blocked (Fired)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-controller="Account" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Modify</a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline">
                                <button type="submit" class="btn @(item.LockoutEnd != null && item.LockoutEnd > DateTime.Now ? "btn-success" : "btn-danger") btn-sm">
                                    @(item.LockoutEnd != null && item.LockoutEnd > DateTime.Now ? "Re-hire" : "Block/Fire")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* MANAGERS (ADMINS) TAB *@
    <div class="tab-pane fade" id="pills-managers" role="tabpanel" aria-labelledby="pills-managers-tab">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>First Name</th><th>Last Name</th><th>Email</th><th>Phone</th>
                    <th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Managers)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>
                            @if (item.LockoutEnd != null && item.LockoutEnd > DateTime.Now)
                            {
                                <span class="badge bg-dark">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-controller="Account" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Modify</a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-danger btn-sm">Toggle Block</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>