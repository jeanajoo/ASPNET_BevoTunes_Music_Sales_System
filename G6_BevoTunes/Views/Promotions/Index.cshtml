@model IEnumerable<G6_BevoTunes.Models.Promotion>

@{
    ViewData["Title"] = "Index";
    Promotion[] FeaturedProducts = Model.Where(p => p.PromotionType == PromotionType.FEATURED).ToArray();
    Promotion[] DiscountedProducts = Model.Where(p => p.PromotionType == PromotionType.DISCOUNT).ToArray();
}

<h1>Promotions List</h1>

@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Create New</a>
    </p>
}


<h3>Featured Products</h3>
<table class="table">
    <thead>
        <tr>
            <th>
                Products
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PromotionActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in FeaturedProducts)
        {
            <tr>
                <td>
                    @{
                        if (item.Songs.Count > 0)
                        {
                            <span><b>Song:</b> @item.Songs[0].SongTitle</span>
                        }
                        else if (item.Albums.Count > 0)
                        {
                            <span><b>Album: </b>@item.Albums[0].AlbumName</span>
                        }
                        else if (item.Artists.Count > 0)
                        {
                            <span><b>Artist:</b> @item.Artists[0].ArtistName</span>
                        }
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PromotionActive)
                </td>
                <td>
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.PromotionId">Details</a>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.PromotionId">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h3>Discounted Products</h3>
<table class="table">
    <thead>
        <tr>
            <th>
                Products
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiscountPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PromotionActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in DiscountedProducts)
        {
            <tr>
                <td>
                    @{
                        if (item.Songs.Count > 0)
                        {
                            <span><b>Song:</b> @item.Songs[0].SongTitle</span>
                        }
                        else if (item.Albums.Count > 0)
                        {
                            <span><b>Album: </b>@item.Albums[0].AlbumName</span>
                        }
                        else if (item.Artists.Count > 0)
                        {
                            <span><b>Artist:</b> @item.Artists[0].ArtistName</span>
                        }
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DiscountPrice)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PromotionActive)
                </td>
                <td>
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.PromotionId">Details</a>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.PromotionId">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
