@model G6_BevoTunes.Models.Promotion
@using G6_BevoTunes.Models

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Promotion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PromotionType" class="control-label"></label>
                <select asp-for="PromotionType" class="form-control" id="PromotionType"
                        asp-items="Html.GetEnumSelectList<PromotionType>()"></select>
                <span asp-validation-for="PromotionType" class="text-danger"></span>
            </div>
            <div class="form-group" id="DiscountPriceGroup">
                <label asp-for="DiscountPrice" class="control-label"></label>
                <input asp-for="DiscountPrice" class="form-control" />
                <span asp-validation-for="DiscountPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Product Category</label>
                <select name="ProductCategory" class="form-control" id="ProductCategory">
                    <option value="">-- Select Category --</option>
                    <option value="Song">Song</option>
                    <option value="Album">Album</option>
                    <option value="Artist" id="ArtistOption">Artist</option>
                </select>
            </div>
            <div class="form-group" id="SongGroup" style="display:none;">
                <label class="control-label">Select a Song</label>
                <select name="SelectedProductId" class="form-control" id="SongSelect">
                    <option value="">-- Select a Song --</option>
                    @foreach (var song in (SelectList)ViewBag.AllSongs)
                    {
                        <option value="@song.Value" data-category="Song">@song.Text</option>
                    }
                </select>
            </div>
            <div class="form-group" id="AlbumGroup" style="display:none;">
                <label class="control-label">Select an Album</label>
                <select name="SelectedProductId" class="form-control" id="AlbumSelect" disabled>
                    <option value="">-- Select an Album --</option>
                    @foreach (var album in (SelectList)ViewBag.AllAlbums)
                    {
                        <option value="@album.Value" data-category="Album">@album.Text</option>
                    }
                </select>
            </div>
            <div class="form-group" id="ArtistGroup" style="display:none;">
                <label class="control-label">Select an Artist</label>
                <select name="SelectedProductId" class="form-control" id="ArtistSelect" disabled>
                    <option value="">-- Select an Artist --</option>
                    @foreach (var artist in (SelectList)ViewBag.AllArtists)
                    {
                        <option value="@artist.Value" data-category="Artist">@artist.Text</option>
                    }
                </select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="PromotionActive" /> @Html.DisplayNameFor(model => model.PromotionActive)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var promoType = document.getElementById('PromotionType');
            var discountPriceGroup = document.getElementById('DiscountPriceGroup');
            var productCategory = document.getElementById('ProductCategory');
            var artistOption = document.getElementById('ArtistOption');
            var songGroup = document.getElementById('SongGroup');
            var albumGroup = document.getElementById('AlbumGroup');
            var artistGroup = document.getElementById('ArtistGroup');
            var songSelect = document.getElementById('SongSelect');
            var albumSelect = document.getElementById('AlbumSelect');
            var artistSelect = document.getElementById('ArtistSelect');

            function updateVisibility() {
                songGroup.style.display = 'none';
                albumGroup.style.display = 'none';
                artistGroup.style.display = 'none';
                songSelect.disabled = true;
                albumSelect.disabled = true;
                artistSelect.disabled = true;
                songSelect.name = '_unused_song';
                albumSelect.name = '_unused_album';
                artistSelect.name = '_unused_artist';

                var selectedCategory = productCategory.value;

                if (selectedCategory === 'Song') {
                    songGroup.style.display = 'block';
                    songSelect.disabled = false;
                    songSelect.name = 'SelectedProductId';
                } else if (selectedCategory === 'Album') {
                    albumGroup.style.display = 'block';
                    albumSelect.disabled = false;
                    albumSelect.name = 'SelectedProductId';
                } else if (selectedCategory === 'Artist') {
                    artistGroup.style.display = 'block';
                    artistSelect.disabled = false;
                    artistSelect.name = 'SelectedProductId';
                }
            }

            function updateAlbumOption() {
                var isDiscount = promoType.value === '1';
                discountPriceGroup.style.display = isDiscount ? 'block' : 'none';
                if (isDiscount) {
                    artistOption.disabled = true;
                    artistOption.style.display = 'none';
                    if (productCategory.value === 'Artist') {
                        productCategory.value = '';
                    }
                } else {
                    artistOption.disabled = false;
                    artistOption.style.display = '';
                    discountPriceGroup.style.display = 'none';
                }
                updateVisibility();
            }

            promoType.addEventListener('change', updateAlbumOption);
            productCategory.addEventListener('change', updateVisibility);

            updateAlbumOption();
        });
    </script>
}
