@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to BevoTunes</h1>
    <div class="btn-group" role="group" aria-label="Basic mixed styles example">
        <a asp-controller="Artists" asp-action="Index" class="btn btn-primary">View Artists</a>
        <a asp-controller="Genres" asp-action="Index" class="btn btn-primary">View Genres</a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">View Songs/Albums</a>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-success">View Orders</a>
        <a asp-controller="Promotions" asp-action="Index" class="btn btn-warning">View Promotions</a>
        <a asp-controller="Reviews" asp-action="Index" class="btn btn-warning">View Reviews</a>
        <a asp-controller="Account" asp-action="List" class="btn btn-info">View User</a>
        <a asp-controller="CustCreditCards" asp-action="Index" class="btn btn-info">View Cards</a>
    </div>
</div>


