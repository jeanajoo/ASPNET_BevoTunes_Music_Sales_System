@model IEnumerable<G6_BevoTunes.Models.Song>

<div class="container">
    <h2>My Purchased Music Rights</h2>

    <form asp-action="MusicRights" method="get" class="mb-3">
        <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
        <div class="input-group" style="max-width: 650px;">
            <input type="text" name="searchString" value="@ViewBag.SearchString" 
                class="form-control" placeholder="Search Song/Album Titles, Artists or Genre" />
            <button type="submit" class="btn btn-dark">Search</button>
        </div>
    </form>

    <div class="mb-3">
        <a asp-action="MusicRights" asp-route-sortOrder="title" asp-route-searchString="@ViewBag.SearchString"
        class="btn btn-outline-dark btn-sm me-1">Title</a>
        <a asp-action="MusicRights" asp-route-sortOrder="artist" asp-route-searchString="@ViewBag.SearchString"
        class="btn btn-outline-dark btn-sm me-1">Artist</a>
        <a asp-action="MusicRights" asp-route-sortOrder="genre" asp-route-searchString="@ViewBag.SearchString"
        class="btn btn-outline-dark btn-sm me-1">Genre</a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Album</th>
                <th>Genre</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Song item in Model)
            {
                <tr>
                    <td>@item.SongTitle</td>
                    <td>@string.Join(", ", item.Artists.Select(a => a.ArtistName))</td>
                    <td>@(item.Albums.FirstOrDefault()?.AlbumName ?? "Single")</td>
                    <td>@string.Join(", ", item.Genres.Select(g => g.GenreName))</td>
                </tr>
            }
        </tbody>
    </table>
</div>