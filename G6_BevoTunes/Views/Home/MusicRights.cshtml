@model IEnumerable<G6_BevoTunes.Models.Song>

<div class="container">
    <h2>My Purchased Music Rights</h2>

    <form asp-action="MusicRights" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Search by title or artist..." />
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    <p>Sort By:</p>
    <div class="btn-group" role="group" aria-label="Basic example">
       <a asp-action="MusicRights" asp-route-sortOrder="title" class="btn btn-primary">Title</a>
       <a asp-action="MusicRights" asp-route-sortOrder="artist" class="btn btn-primary">Artist</a>
       <a asp-action="MusicRights" asp-route-sortOrder="genre" class="btn btn-primary">Genre</a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Album</th>
                <th>Genre</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Song item in Model)
            {
                <tr>
                    <td>@item.SongTitle</td>
                    <td>@string.Join(", ", item.Artists.Select(a => a.ArtistName))</td>
                    <td>@(item.Albums.FirstOrDefault()?.AlbumName ?? "Single")</td>
                    <td>@string.Join(", ", item.Genres.Select(g => g.GenreName))</td>
                </tr>
            }
        </tbody>
    </table>
</div>