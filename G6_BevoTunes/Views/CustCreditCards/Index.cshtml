@model IEnumerable<G6_BevoTunes.Models.CustCreditCard>

@{
    ViewData["Title"] = "Index";
}

<h1>Your Credit Cards</h1>

@if (Model.Count() < 2)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Add New Card</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CardNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CardType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CardNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CardType)
                </td>
                <td>
                    <a asp-action="Edit" class="btn btn-warning" asp-route-id="@item.CustCreditCardID">Edit</a>
                    <a asp-action="Details" class="btn btn-primary" asp-route-id="@item.CustCreditCardID">Details</a>
                    <a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.CustCreditCardID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
