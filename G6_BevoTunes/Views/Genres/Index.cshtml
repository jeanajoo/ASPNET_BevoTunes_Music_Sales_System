@model IEnumerable<G6_BevoTunes.Models.Genre>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
    <a asp-action="InactiveList" class="btn btn-warning">
        <i class="bi bi-eye-slash"></i> View Inactive Genres
    </a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GenreName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.GenreName)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.GenreId" class="btn btn-info">View Songs</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.GenreId" class="btn btn-warning">Edit</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
