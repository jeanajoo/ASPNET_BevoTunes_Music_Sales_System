@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - G6 BevoTunes</title>
    @* <link href="~/lib/twitter-bootstrap/css/bootstrap.css" rel="stylesheet" /> *@
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/G6_BevoTunes.styles.css" asp-append-version="true" />
</head>

<body>
    <div>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#nav-content"
                        aria-controls="nav-content" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav-content">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Search" asp-action="Index" class="nav-link">Search</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <li>
                                    <a asp-controller="Home" asp-action="MusicRights" class="nav-link">View Music Rights</a>
                                </li>
                                <li>
                                    <a asp-controller="Orders" asp-action="Index" class="nav-link">View Orders</a>
                                </li>
                                <li>
                                    <a asp-controller="Orders" asp-action="Details" class="nav-link">View Cart</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                            {
                                <li>
                                    <a asp-controller="Account" asp-action="UserIndex" class="nav-link">Manage Users</a>
                                </li>
                                <li>
                                    <a asp-controller="Orders" asp-action="Index" class="nav-link">Manage Orders</a>
                                </li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a asp-controller="RoleAdmin" asp-action="Index" class="nav-link">Manage Roles</a>
                                </li>
                                <li>
                                    <a asp-controller="Promotions" asp-action="Index" class="nav-link">Manage Featured
                                        Items/Discounts</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Reviews" asp-action="Index" class="nav-link">Manage Reviews</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Reports" asp-action="Index" class="nav-link">View Reports</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Artists" asp-action="Index" class="nav-link">Manage Artists</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Genres" asp-action="Index" class="nav-link">View Genres</a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </nav>
        </div>

        <div class="container">
            @RenderBody()
        </div>

        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/popper.js/popper.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
        <script src="~/lib/jquery-validate/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

        @RenderSection("Scripts", required: false)
    
    </body>

</html>