@using Microsoft.AspNetCore.Razor.Language
@using Microsoft.CodeAnalysis.CSharp.Syntax
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model IEnumerable<G6_BevoTunes.Models.Order>

<h3 class="fw-bold mb-1">Order Information</h3>

<ul class="list-group" style="max-width: 300px;">
        <br/>
        <h5 class="fw-semibold mb-3">Your Order</h5>
        @foreach (var item in Model)
            {
                <div>
                    <strong>Card Used:</strong>
                    **** **** **** @item.Card?.CardNumber[^4..]
                </div>
                <div>
                    <strong>Card Type:</strong>
                    @item.Card?.CardType
                </div>
                <div>
                    <strong>Recipient:</strong>
                    @item.Recipient.FirstName @item.Recipient.LastName
                </div>
                <div>
                    <strong>Order Total:</strong>
                    @item.OrderTotal.ToString("C")          
                </div>
                <br/>
                @foreach (var detail in item.OrderDetails)
                {
                    var discount = detail.Song?.Promotions?
                        .FirstOrDefault(p => p.PromotionType == PromotionType.DISCOUNT && p.PromotionActive == true)
                        ?? detail.Album?.Promotions?
                        .FirstOrDefault(p => p.PromotionType == PromotionType.DISCOUNT && p.PromotionActive == true);

                    <li class="list-group-item d-flex justify-content-between">
                        <span>
                            @if (detail.Song != null)
                            {
                                <b>Song:</b> @detail.Song.SongTitle
                            }
                            else if (detail.Album != null)
                            {
                                <b>Album:</b> @detail.Album.AlbumName
                            }
                        </span>
                        <span>
                            @detail.PurchasedPrice.ToString("C")
                        </span>
                    </li>
                }
            }
    </ul>
    <br/>
    <div class="d-flex justify-content-front">
        <a asp-action="Confirm" class="btn btn-primary">
            Place Order
        </a>
    </div>
