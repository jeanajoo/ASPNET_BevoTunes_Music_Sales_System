@model IEnumerable<G6_BevoTunes.Models.Order>

@{
    ViewData["Title"] = "Order History";
}

<h1>Index</h1>
@if (User.IsInRole("Admin") || User.IsInRole("Employee"))
{
    <p>
    <a asp-action="Create">Create Order For Customer</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderStatus)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            @if (@item.OrderStatus == OrderStatus.Ordered){
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderStatus)
            </td>
            <td>
                <a asp-action="Refund" asp-route-id="@item.OrderID">Refund</a> 
            </td>
            }
        </tr>
}
    </tbody>
</table>
