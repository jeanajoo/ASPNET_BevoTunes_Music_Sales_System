@model G6_BevoTunes.Models.Review

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Review</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label>Select Type</label>
                <select id="productType" class="form-control">
                    <option value="">-- Select Type --</option>
                    <option value="Song">Song</option>
                    <option value="Album">Album</option>
                    <option value="Artist">Artist</option>
                </select>
            </div>
            <div id="songDiv" style="display:none">
                <label>Song</label>
                @Html.DropDownList("SelectedSong", (SelectList)ViewBag.ownedSongs, "-- Select Song --", new { @class = "form-control" })
            </div>
            <div id="albumDiv" style="display:none">
                <label>Album</label>
                @Html.DropDownList("SelectedAlbum", (SelectList)ViewBag.ownedAlbums, "-- Select Album --", new { @class = "form-control" })
            </div>
            <div id="artistDiv" style="display:none">
                <label>Artist</label>
                @Html.DropDownList("SelectedArtist", (SelectList)ViewBag.ownedArtists, "-- Select Artist --", new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Rating" class="control-label"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById("productType").addEventListener("change", function () {
            let type = this.value;

            document.getElementById("songDiv").style.display = "none";
            document.getElementById("albumDiv").style.display = "none";
            document.getElementById("artistDiv").style.display = "none";

            if (type === "Song") {
                document.getElementById("songDiv").style.display = "block";
            }
            else if (type === "Album") {
                document.getElementById("albumDiv").style.display = "block";
            }
            else if (type === "Artist") {
                document.getElementById("artistDiv").style.display = "block";
            }
        });
    </script>
}
