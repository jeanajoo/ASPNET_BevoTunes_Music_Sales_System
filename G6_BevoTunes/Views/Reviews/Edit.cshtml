@model G6_BevoTunes.Models.Review
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Review</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReviewID" />
            <div class="form-group"
                @{
                    if (Model.Song != null) 
                    {
                        <span><b>Song:</b> @Model.Song.SongTitle</span>
                    }
                    else if (Model.Album != null)
                    {
                        <span><b>Album:</b> @Model.Album.AlbumName</span>
                    }
                    else if (Model.Artist != null)
                    {
                        <span><b>Artist:</b> @Model.Artist.ArtistName</span>
                    }
                }
            <br/>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
               @if (Model.Reviewer != null && Model.Reviewer.Id == userId)
                {

                    <div class="form-group">
                        <label asp-for="Rating"></label>
                        <input asp-for="Rating" class="form-control" />
                    </div>
                }
                else
                {

                    <div class="form-group">
                        <label>Rating</label>
                        <p>@Model.Rating</p>
                    </div>

                    <input type="hidden" asp-for="Rating" />
                }
            </div>
        <div class="form-group">
            @if ((User.IsInRole("Admin") || User.IsInRole("Employee")) && Model.Status == ReviewStatus.Pending)
            {
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<ReviewStatus>()"
                        class="form-control">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            }
            else
            {
                <label>Status</label>
                <p>@Model.Status</p>
                <input type="hidden" asp-for="Status" />
            }
        </div>
            </br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary me-1" /> 
                <a asp-action="Index" class = "btn btn-primary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
