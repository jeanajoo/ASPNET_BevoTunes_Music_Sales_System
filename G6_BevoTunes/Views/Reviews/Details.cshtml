@model G6_BevoTunes.Models.Review

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Review</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @{
                if (Model.Song != null) {
                    <span>Song:</span>
                } 
                else if (Model.Album != null) 
                {
                    <span>Album:</span>
                } 
                else if (Model.Artist != null) 
                {
                    <span>Artist:</span>
                }
            }
        </dt>
        <dd class = "col-sm-10">
            @{
                if (Model.Song != null) {
                    <span>@Model.Song.SongTitle</span>
                } 
                else if (Model.Album != null) 
                {
                    <span>@Model.Album.AlbumName</span>
                } 
                else if (Model.Artist != null) 
                {
                    <span>@Model.Artist.ArtistName</span>
                }
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Rating)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rating)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ReviewID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
