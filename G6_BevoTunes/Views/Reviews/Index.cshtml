@using System.Security.Claims
@using Microsoft.AspNetCore.Razor.Language
@using Microsoft.CodeAnalysis.CSharp.Syntax
@using Microsoft.EntityFrameworkCore.Query
@model IEnumerable<G6_BevoTunes.Models.Review>

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@{
    ViewData["Title"] = "Index";
}

<h1>Reviews List</h1>

<p> @if (User.IsInRole("Customer") && (ViewBag.HasProduct as bool?) == true)
    {
    <a asp-action="Create">Create New</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                <span>Products</span>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @{
                    if (item.Song != null) {
                        <span><b>Song:</b> @item.Song.SongTitle</span>
                    } 
                    else if (item.Album != null) 
                    {
                        <span><b>Album:</b> @item.Album.AlbumName</span>
                    } 
                    else if (item.Artist != null) 
                    {
                        <span><b>Artist:</b> @item.Artist.ArtistName</span>
                    }
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @if ((User.IsInRole("Admin") || User.IsInRole("Employee") || item.Reviewer.Id == userId) && item.Status != ReviewStatus.Deleted)
                {
                    <a asp-action="Edit" asp-route-id="@item.ReviewID">Edit</a> <span>|</span>
                }
                <a asp-action="Details" asp-route-id="@item.ReviewID">Details</a> |
                @if (User.IsInRole("Customer") && item.Reviewer.Id == userId && item.Status != ReviewStatus.Deleted) 
                {
                <a asp-action="Delete" asp-route-id="@item.ReviewID">Delete Review</a> 
                }

            </td>
        </tr>
}
    </tbody>
</table>
