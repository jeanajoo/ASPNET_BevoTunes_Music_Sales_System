@model G6_BevoTunes.Models.Artist

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Artist</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ArtistId" />
            <div class="form-group">
                <label asp-for="ArtistName" class="control-label"></label>
                <input asp-for="ArtistName" class="form-control" />
                <span asp-validation-for="ArtistName" class="text-danger"></span>
            </div>

            <!-- Genres Selection -->
            <div class="form-group mb-3">
                <label class="form-label">Genres</label>
                <div class="border p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                    @{
                        var genres = ViewBag.AllGenres as SelectList;
                        var selectedGenres = ViewData["SelectedGenres"] as List<int>;
                        if (genres != null)
                        {
                            @foreach (var genre in genres)
                            {
                                var isSelected = selectedGenres != null && selectedGenres.Contains(int.Parse(genre.Value));
                                <div class="form-check">
                                    <input type="checkbox" name="selectedGenres" value="@genre.Value" class="form-check-input" id="genre_@genre.Value" @(isSelected ? "checked" : "") />
                                    <label class="form-check-label" for="genre_@genre.Value">
                                        @genre.Text
                                    </label>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
            <a asp-controller="Genres" asp-action="Create" class="btn btn-success mb-3" target="_blank">Create New Genre</a>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
