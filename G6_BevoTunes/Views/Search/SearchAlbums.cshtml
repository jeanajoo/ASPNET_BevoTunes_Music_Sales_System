@model G6_BevoTunes.Models.AlbumSearchViewModel

@{
    ViewData["Title"] = "Search Albums";
}

<h1>Search Albums</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="DisplaySearchResults" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Album Name -->
            <div class="form-group mb-3">
                <label asp-for="AlbumName" class="form-label"></label>
                <input asp-for="AlbumName" class="form-control" />
                <span asp-validation-for="AlbumName" class="text-danger"></span>
            </div>

            <!-- Artist Name -->
            <div class="form-group mb-3">
                <label asp-for="ArtistName" class="form-label"></label>
                <input asp-for="ArtistName" class="form-control" />
                <span asp-validation-for="ArtistName" class="text-danger"></span>
            </div>

            <!-- Genre Selection -->
            <div class="form-group mb-3">
                <label asp-for="Genre" class="form-label"></label>
                <select asp-for="Genre" class="form-select">
                    <option value="0">-- All Genres --</option>
                    @if (ViewBag.AllGenres != null)
                    {
                        @foreach (var genre in ViewBag.AllGenres)
                        {
                            <option value="@genre.GenreId">@genre.GenreName</option>
                        }
                    }
                </select>
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <!-- Rating Filter -->
            <div class="form-group mb-3">
                <label class="form-label">Rating</label>
                <div class="row">
                    <div class="col-md-6">
                        <select asp-for="RatingBound" class="form-select">
                            <option value="GreaterThan">Greater Than or Equal To</option>
                            <option value="LessThan">Less Than or Equal To</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Rating" type="number" min="1" max="5" step="0.1" class="form-control" placeholder="1.0 - 5.0" />
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>
                </div>
                <small class="form-text text-muted">Leave Rating blank for no rating filter</small>
            </div>
            
            <!-- Submit Button -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Search Albums</button>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
