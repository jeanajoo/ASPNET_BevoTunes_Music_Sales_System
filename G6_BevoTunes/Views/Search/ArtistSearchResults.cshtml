@model IEnumerable<G6_BevoTunes.Models.Artist>

@{
    ViewData["Title"] = "Artist Search Results";
}

<h1>Artist Search Results</h1>

<p>
    <a asp-action="SearchArtists" asp-controller="Search" class="btn btn-secondary">New Search</a>
    <a asp-action="Index" asp-controller="Search" class="btn btn-secondary">Back to Search</a>
</p>

<form asp-controller="Search" asp-action="DisplayArtistSearchResults" method="get" class="mb-4">
    <input type="hidden" name="ArtistName" value="@ViewBag.SearchName" />
    <input type="hidden" name="Rating" value="@ViewBag.SearchRating" />
    <input type="hidden" name="RatingBound" value="@ViewBag.SearchRatingBound" />
    <input type="hidden" name="SelectedCustomerId" value="@ViewBag.SelectedCustomerId" />
    <input type="hidden" name="SelectedCustomerEmail" value="@ViewBag.SelectedCustomerEmail" />

    @if (ViewBag.CurrentGenres != null)
    {
        foreach (var genreId in (int[])ViewBag.CurrentGenres)
        {
            <input type="hidden" name="selectedGenres" value="@genreId" />
        }
    }

    <div class="row">
        <div class="col-md-5">
            <div class="input-group shadow-sm">
                <label class="input-group-text bg-primary text-white border-primary" for="sortOrder">
                    <i class="bi bi-sort-down me-1"></i> Sort By
                </label>
                <select class="form-select border-primary" name="sortOrder" id="sortOrder">
                    <option value="title_asc" selected="@(ViewBag.CurrentSort == "title_asc" || string.IsNullOrEmpty(ViewBag.CurrentSort))">Name (A to Z)</option>
                    <option value="title_desc" selected="@(ViewBag.CurrentSort == "title_desc")">Name (Z to A)</option>
                    <option value="rating_desc" selected="@(ViewBag.CurrentSort == "rating_desc")">Rating (High to Low)</option>
                    <option value="rating_asc" selected="@(ViewBag.CurrentSort == "rating_asc")">Rating (Low to High)</option>
                </select>
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </div>
    </div>
</form>

<p>
    @if (TempData["DisplayArtistsMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["DisplayArtistsMessage"]
        </div>
    }
</p>

@if (Model.Count() == 0)
{
    <div class="alert alert-info">
        No artists found matching your search criteria.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ArtistName)
                </th>
                <th>Genres</th>
                <th>Albums</th>
                <th>Songs</th>
                <th>Rating</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ArtistName)
                </td>
                <td>
                    @string.Join(", ", item.Genres.Select(g => g.GenreName))
                </td>
                <td>
                    @item.Albums.Count()
                </td>
                <td>
                    @item.Songs.Count()
                </td>
                <td>
                    @if (item.Reviews.Any())
                    {
                        @string.Format("{0:F2}", item.Reviews.Average(r => r.Rating))
                    }
                    else
                    {
                        <span>No ratings</span>
                    }
                </td>
                <td>
                    <a asp-controller="Artists" asp-action="Details" asp-route-id="@item.ArtistId">Details</a>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <a asp-controller="Artists" asp-action="Edit" asp-route-id="@item.ArtistId">Edit</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
