@model G6_BevoTunes.Models.ProductsViewModel

@{
    ViewData["Title"] = "Products";
    // Preserve TempData across requests
    if (TempData["SelectedCustomerId"] != null)
    {
        TempData.Keep("SelectedCustomerId");
        TempData.Keep("SelectedCustomerEmail");
    }
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if ((User.IsInRole("Admin") || User.IsInRole("Employee")) && TempData["SelectedCustomerId"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <strong>Customer Mode Active:</strong> You are ordering for @TempData["SelectedCustomerEmail"].
        @if (TempData["OrderId"] != null)
        {
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@TempData["OrderId"]"
                   class="btn btn-sm btn-outline-info ms-2">
                <i class="bi bi-cart-check"></i> View Order Details
            </a>
        }
        <a asp-controller="Orders" asp-action="ClearCustomerContext" class="btn btn-sm btn-outline-info ms-2">
            <i class="bi bi-x-circle"></i> Drop Customer
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="SearchArtists" class="btn btn-success">Lookup Artists!</a>
        <a asp-action="SearchAlbums" class="btn btn-success">Lookup Albums!</a>
        <a asp-action="SearchSongs" class="btn btn-success">Lookup Songs!</a>
    </div>
    @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Employee")))
    {
        <a asp-controller="Orders" asp-action="SelectCustomer" class="btn btn-info">
            <i class="bi bi-person-check"></i> @(TempData["SelectedCustomerId"] != null ? "Switch Customer" : "Select Customer")
        </a>
    }
</div>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">Products</h1>
            <p class="text-muted">Manage BevoTunes catalog - Songs and Albums</p>
        </div>
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <div class="col-md-4 text-end">
                <a asp-controller="Songs" asp-action="Create" class="btn btn-success me-2">
                    <i class="bi bi-plus-circle"></i> Add Song
                </a>
                <a asp-controller="Albums" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add Album
                </a>
            </div>
        }
    </div>

@if (TempData["DisplaySongsMessage"] != null)
{
    <p>
        <div class="alert alert-info">
            @TempData["DisplaySongsMessage"]
        </div>
    </p>
}
else if (TempData["DisplayAlbumsMessage"] != null)
{
    <p>
        <div class="alert alert-info">
            @TempData["DisplayAlbumsMessage"]
        </div>
    </p>
}

    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-songs-tab" data-bs-toggle="pill" data-bs-target="#pills-songs"
                    type="button" role="tab" aria-controls="pills-songs" aria-selected="true">Songs <span
                class="badge text-bg-light">@(Model.Songs == null ? 0 : Model.Songs.Count)</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-albums-tab" data-bs-toggle="pill" data-bs-target="#pills-albums"
                        type="button" role="tab" aria-controls="pills-albums" aria-selected="false">Albums <span
                    class="badge text-bg-light">@(Model.Albums == null ? 0 : Model.Albums.Count)</span></button>
                </li>
            </ul>
            <div class="tab-content" id="pills-tabContent">
                <div class="tab-pane fade show active" id="pills-songs" role="tabpanel" aria-labelledby="pills-songs-tab">
                    @if (Model.Songs != null && Model.Songs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Song Title</th>
                                        <th>Price</th>
                                        <th>Artists</th>
                                        <th>Genres</th>
                                        <th>Albums</th>
                                        <th>Rating</th>
                                        <th style="width: 200px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var song in Model.Songs)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@song.SongTitle</strong>
                                            </td>
                                            <td>
                                                @string.Format("{0:C}", song.SongPrice)
                                            </td>
                                            <td>
                                                @if (song.Artists != null && song.Artists.Any())
                                                {
                                                    <div class="badge bg-info">@song.Artists.Count artist(s)</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (song.Genres != null && song.Genres.Any())
                                                {
                                                    @foreach (var genre in song.Genres.Take(2))
                                                    {
                                                        <span class="badge bg-secondary me-1">@genre.GenreName</span>
                                                    }
                                                    @if (song.Genres.Count > 2)
                                                    {
                                                        <span class="badge bg-secondary">+@(song.Genres.Count - 2)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (song.Albums != null && song.Albums.Any())
                                                {
                                                    <div class="badge bg-warning">@song.Albums.Count album(s)</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (song.Reviews != null && song.Reviews.Count > 0)
                                                {
                                                    <div class="badge bg-warning">@song.Reviews.Average(r => r.Rating)</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No reviews yet</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (User.Identity.IsAuthenticated)
                                                {
                                                    @if (User.IsInRole("Customer") || ((User.IsInRole("Admin") || User.IsInRole("Employee"))
                                                                                                                                                                                                                                                                                                                                                        && TempData["SelectedCustomerId"] != null))
                                                    {
                                                        <a asp-controller="Orders" asp-action="AddSongToCart" asp-route-id="@song.SongId"
                                                               class="btn btn-sm btn-success me-2">
                                                            <i class="bi bi-cart-plus"></i> Add to Cart
                                                        </a>
                                                    }
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a asp-controller="Songs" asp-action="Edit" asp-route-id="@song.SongId"
                                                               class="btn btn-sm btn-warning me-2">
                                                            <i class="bi bi-pencil"></i> Edit
                                                        </a>

                                                        <a asp-controller="Songs" asp-action="Delete" asp-route-id="@song.SongId"
                                                               class="btn btn-sm btn-danger me-2">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </a>
                                                    }
                                                    <a asp-controller="Songs" asp-action="Details" asp-route-id="@song.SongId"
                                                           class="btn btn-sm btn-info">
                                                        <i class="bi bi-info-circle"></i> Details
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> No songs found. 
                            @if(User.IsInRole("Admin")) {
                                 <a asp-controller="Songs" asp-action="Create">Create your first song.</a>
                            }
                        </div>
                    }
                </div>
                <div class="tab-pane fade" id="pills-albums" role="tabpanel" aria-labelledby="pills-albums-tab">
                    @if (Model.Albums != null && Model.Albums.Any())
                    {
                        <div class="row">
                            @foreach (var album in Model.Albums)
                            {
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100 shadow-sm">
                                        @if (!string.IsNullOrEmpty(album.AlbumCover))
                                        {
                                            <img src="@album.AlbumCover" class="card-img-top" alt="@album.AlbumName"
                                                 style="height: 200px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                                 style="height: 200px;">
                                                <i class="bi bi-collection" style="font-size: 3rem; color: #ccc;"></i>
                                            </div>
                                        }

                                        <div class="card-body">
                                            <h5 class="card-title">@album.AlbumName</h5>

                                            <div class="mb-2">
                                                <p class="card-text text-muted">
                                                    <strong>Price:</strong> @string.Format("{0:C}", album.AlbumPrice)
                                                </p>
                                            </div>

                                            @if (album.Artists != null && album.Artists.Any())
                                            {
                                                <p class="card-text">
                                                    <strong>Artists:</strong>
                                                    <br />
                                                    @foreach (var artist in album.Artists)
                                                    {
                                                        <span class="badge bg-info">@artist.ArtistName</span>
                                                    }
                                                </p>
                                            }

                                            @if (album.Genres != null && album.Genres.Any())
                                            {
                                                <p class="card-text">
                                                    <strong>Genres:</strong>
                                                    <br />
                                                    @foreach (var genre in album.Genres)
                                                    {
                                                        <span class="badge bg-secondary">@genre.GenreName</span>
                                                    }
                                                </p>
                                            }

                                            @if (album.Songs != null && album.Songs.Any())
                                            {
                                                <p class="card-text text-muted">
                                                    <i class="bi bi-music-note"></i> @album.Songs.Count song(s)
                                                </p>
                                            }
                                        
                                            @if (album.Reviews != null && album.Reviews.Count > 0)
                                            {
                                                <p class="card-text text-muted">
                                                    <i class="bi bi-percent"></i> Rating: @album.Reviews.Average(r => r.Rating)
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="card-text text-muted">
                                                    <i class="bi bi-percent"></i> Rating: No reviews yet
                                                </p>
                                            }
                                        </div>
                                        <div class="card-footer bg-white">
                                            @if (User.Identity.IsAuthenticated)
                                            {
                                                @if (User.IsInRole("Customer") || ((User.IsInRole("Admin") || User.IsInRole("Employee")) &&
                                                                                                                                                                                                                                                                                                                                    TempData["SelectedCustomerId"] != null))
                                                {
                                                    <a asp-controller="Orders" asp-action="AddAlbumToCart" asp-route-id="@album.AlbumId"
                                                           class="btn btn-sm btn-success me-2">
                                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                                    </a>
                                                }
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <a asp-controller="Albums" asp-action="Edit" asp-route-id="@album.AlbumId"
                                                           class="btn btn-sm btn-warning me-2">
                                                        <i class="bi bi-pencil"></i> Edit
                                                    </a>
                                                    <a asp-controller="Albums" asp-action="Delete" asp-route-id="@album.AlbumId"
                                                           class="btn btn-sm btn-danger me-2">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </a>

                                                }
                                            }
                                            <a asp-controller="Albums" asp-action="Details" asp-route-id="@album.AlbumId"
                                                   class="btn btn-sm btn-info me-2">
                                                <i class="bi bi-info-circle"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> No albums found.
                            @if(User.IsInRole("Admin")) {
                                 <a asp-controller="Albums" asp-action="Create">Create your first album.</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
