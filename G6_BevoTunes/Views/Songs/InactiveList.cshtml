@model IEnumerable<Song>

@{
    ViewData["Title"] = "Inactive Songs";
}

<h1>Inactive Songs</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Index" class="btn btn-secondary">Back to Active Songs</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No inactive songs found.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Song Title</th>
                <th>Price</th>
                <th>Artists</th>
                <th>Genres</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var song in Model)
            {
                <tr>
                    <td>@song.SongTitle</td>
                    <td>@string.Format("{0:C}", song.SongPrice)</td>
                    <td>
                        @if (song.Artists.Any())
                        {
                            @string.Join(", ", song.Artists.Select(a => a.ArtistName).Take(2))
                            @if (song.Artists.Count > 2)
                            {
                                <span>+@(song.Artists.Count - 2) more</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No artists</span>
                        }
                    </td>
                    <td>
                        @if (song.Genres.Any())
                        {
                            @string.Join(", ", song.Genres.Select(g => g.GenreName).Take(2))
                            @if (song.Genres.Count > 2)
                            {
                                <span>+@(song.Genres.Count - 2) more</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No genres</span>
                        }
                    </td>
                    <td>
                        <form asp-action="Activate" asp-route-id="@song.SongId" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-success">
                                <i class="bi bi-check-circle"></i> Reactivate
                            </button>
                        </form>
                        <a asp-action="Details" asp-route-id="@song.SongId" class="btn btn-sm btn-info">
                            <i class="bi bi-eye"></i> View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
