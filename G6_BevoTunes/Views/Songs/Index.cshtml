@model G6_BevoTunes.Models.ProductsViewModel

@{
    ViewData["Title"] = "Products";
    
    // Get featured songs (songs with active FEATURED promotions)
    var featuredSongs = Model.Songs?
        .Where(s => s.Promotions?.Any(p => p.PromotionType == PromotionType.FEATURED && p.PromotionActive) ?? false)
        .ToList() ?? new List<Song>();

    // Get promoted songs (songs with active DISCOUNT promotions)
    var promotedSongs = Model.Songs?
        .Where(s => s.Promotions?.Any(p => p.PromotionType == PromotionType.DISCOUNT && p.PromotionActive) ?? false)
        .ToList() ?? new List<Song>();
}



    <!-- Featured Songs Section -->
    @if (featuredSongs.Any())
    {
        <div class="mb-5">
            <h2 class="mb-4"><i class="bi bi-star-fill text-warning"></i> Featured Songs</h2>
            <div class="row">
                @foreach (var song in featuredSongs.Take(6))
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm border-warning">
                            <div class="card-body">
                                <div class="badge bg-warning text-dark mb-2">Featured</div>
                                <h5 class="card-title">@song.SongTitle</h5>
                                <p class="card-text">
                                    <strong>Price:</strong> @string.Format("{0:C}", song.SongPrice)
                                </p>
                                @if (song.Artists?.Any() ?? false)
                                {
                                    <p class="card-text">
                                        <strong>Artists:</strong>
                                        @string.Join(", ", song.Artists.Select(a => a.ArtistName).Take(2))
                                        @if (song.Artists.Count > 2)
                                        {
                                            <text>+@(song.Artists.Count - 2)</text>
                                        }
                                    </p>
                                }
                                @if (song.Genres?.Any() ?? false)
                                {
                                    <p class="card-text">
                                        <strong>Genres:</strong>
                                        @string.Join(", ", song.Genres.Select(g => g.GenreName).Take(2))
                                    </p>
                                }
                                <div class="mt-3">
                                    <a asp-controller="Products" asp-action="SongDetails" asp-route-id="@song.SongId" class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Promoted/Discount Songs Section -->
    @if (promotedSongs.Any())
    {
        <div class="mb-5">
            <h2 class="mb-4"><i class="bi bi-tag-fill text-danger"></i> On Promotion</h2>
            <div class="row">
                @foreach (var song in promotedSongs.Take(6))
                {
                    var promotion = song.Promotions.FirstOrDefault(p => p.PromotionType == PromotionType.DISCOUNT && p.PromotionActive);
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm border-danger">
                            <div class="card-body">
                                <div class="badge bg-danger mb-2">On Sale</div>
                                <h5 class="card-title">@song.SongTitle</h5>
                                <p class="card-text">
                                    <strong>Original Price:</strong>
                                    <span class="text-decoration-line-through">@string.Format("{0:C}", song.SongPrice)</span>
                                </p>
                                @if (promotion != null)
                                {
                                    <p class="card-text">
                                        <strong class="text-danger">Promotion Price:</strong>
                                        <span class="h5 text-danger">@string.Format("{0:C}", promotion.DiscountPrice)</span>
                                    </p>
                                }
                                @if (song.Artists?.Any() ?? false)
                                {
                                    <p class="card-text">
                                        <strong>Artists:</strong>
                                        @string.Join(", ", song.Artists.Select(a => a.ArtistName).Take(2))
                                        @if (song.Artists.Count > 2)
                                        {
                                            <text>+@(song.Artists.Count - 2)</text>
                                        }
                                    </p>
                                }
                                <div class="mt-3">
                                    <a asp-controller="Products" asp-action="SongDetails" asp-route-id="@song.SongId" class="btn btn-sm btn-outline-danger">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }


        <style>
            .card {
                border: 1px solid #dee2e6;
                border-radius: 0.5rem;
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
            }

            .table-hover tbody tr:hover {
                background-color: #f8f9fa;
            }

            .nav-tabs .nav-link.active {
                border-bottom: 3px solid #007bff;
                font-weight: 600;
            }
        </style>