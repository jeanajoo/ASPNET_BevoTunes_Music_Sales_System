@model G6_BevoTunes.Models.Song

@{
    ViewData["Title"] = "Details";
}

<h1>Song Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SongTitle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SongTitle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SongPrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SongPrice)
        </dd>
    </dl>
</div>

<div>
    <h4>Artists</h4>
    @if (Model.Artists != null && Model.Artists.Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Artist Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var artist in Model.Artists)
                {
                    <tr>
                        <td>@artist.ArtistName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p><strong>Artist Unknown</strong></p>
    }
</div>

<div>
    <h4>Albums</h4>
    @if (Model.Albums != null && Model.Albums.Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Album Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var album in Model.Albums)
                {
                    <tr>
                        <td>@album.AlbumName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p><strong>Album Unknown</strong></p>
    }
</div>

<div class="mt-4">
    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
    {
        <p>
            <a asp-action="Edit" asp-route-id="@Model?.SongId" class="btn btn-warning">Edit</a>
        </p>
    }
    <p>
        <a asp-controller="Orders" asp-action="AddSongToCart" asp-route-id="@Model.SongId" class="btn btn-success">
            <i class="bi bi-cart-plus"></i> Add to Cart
        </a>
    </p>
    <a asp-action="Index" class="btn btn-secondary">Back to Albums</a>
</div>