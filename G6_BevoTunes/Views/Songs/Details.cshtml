@model G6_BevoTunes.Models.Song

@{
    ViewData["Title"] = "Details";
}

<h1>Song Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SongTitle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SongTitle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SongPrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SongPrice)
        </dd>

        @if (Model.Promotions.Count > 0 && Model.Promotions.Any(p => p.PromotionType == PromotionType.DISCOUNT && p.PromotionActive == true))
        {
           <dt class = "col-sm-2">Discounted Price</dt>
            <dd class = "col-sm-10">
                @Model.Promotions.FirstOrDefault(p => p.PromotionType == PromotionType.DISCOUNT)?.DiscountPrice.ToString("C")
            </dd>
        }
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AverageRating)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.AverageRating == -1.0m)
            {
                <dd class="col-sm-8">
                    Not Rated Yet
                </dd>
            }
            else
            {
                <dd class="col-sm-8">
                    @Model.AverageRating / 5.0
                </dd>
            }
        </dd>
    </dl>
</div>

<div>
    <h4>Artists</h4>
    @if (Model.Artists != null && Model.Artists.Count > 0)
    {
        <table class="table table-striped">
            <tbody>
                @foreach (var artist in Model.Artists)
                {
                    <tr>
                        <td>@artist.ArtistName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p><strong>Artist Unknown</strong></p>
    }
</div>

<div>
    <h4>Albums</h4>
    @if (Model.Albums != null && Model.Albums.Count > 0)
    {
        <table class="table table-striped">
            <tbody>
                @foreach (var album in Model.Albums)
                {
                    <tr>
                        <td>@album.AlbumName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p><strong>Album Unknown</strong></p>
    }
</div>

<!-- Reviews -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Reviews</h5>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Customer"))
                    {
                        <a asp-controller="Reviews" asp-action="Create" asp-route-songId="@Model.SongId" class="btn btn-sm btn-primary">Write Review</a>
                    }
                </div>
                <div class="card-body">
                    @if (Model.Reviews != null && Model.Reviews.Count > 0)
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            @if (review.Status.ToString() == "Approve")
                            {
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="card-subtitle text-muted">@review.Reviewer?.UserName</h6>
                                                <div class="mt-2">
                                                    @for (int i = 0; i < review.Rating; i++)
                                                    {
                                                        <span class="text-warning">★</span>
                                                    }
                                                    @for (int i = review.Rating; i < 5; i++)
                                                    {
                                                        <span class="text-muted">★</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <p class="card-text mt-2">@review.Description</p>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p class="text-muted">No approved reviews yet.</p>
                    }
                </div>
            </div>

    <div class="mt-4">
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <p>
                <a asp-action="Edit" asp-route-id="@Model?.SongId" class="btn btn-warning">Edit</a>
            </p>
            <p>
                <a asp-action="Delete" asp-route-id="@Model?.SongId" class="btn btn-warning">Delete</a>
            </p>
        }
        @if (User.Identity.IsAuthenticated && User.IsInRole("Customer"))
        {
            <p>
                <a asp-controller="Orders" asp-action="AddSongToCart" asp-route-id="@Model.SongId" class="btn btn-success">
                    <i class="bi bi-cart-plus"></i> Add to Cart
                </a>
            </p>
        }
        <a asp-controller="Search" asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
