@model G6_BevoTunes.Models.Song

@{
    ViewData["Title"] = "Create Song";
}

<h1>Create Song</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <!-- Song Title -->
            <div class="form-group mb-3">
                <label asp-for="SongTitle" class="form-label"></label>
                <input asp-for="SongTitle" class="form-control" />
                <span asp-validation-for="SongTitle" class="text-danger"></span>
            </div>

            <!-- Song Price -->
            <div class="form-group mb-3">
                <label asp-for="SongPrice" class="form-label"></label>
                <input asp-for="SongPrice" class="form-control" step="0.01" type="number" />
                <span asp-validation-for="SongPrice" class="text-danger"></span>
            </div>

            <!-- Artists Selection -->
            <div class="form-group mb-3">
                <label class="form-label">Artists</label>
                <div class="border p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                    @{
                        var artists = ViewBag.Artists as SelectList;
                        if (artists != null)
                        {
                            @foreach (var artist in artists)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="selectedArtists" value="@artist.Value" class="form-check-input" id="artist_@artist.Value" />
                                    <label class="form-check-label" for="artist_@artist.Value">
                                        @artist.Text
                                    </label>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <!-- Genres Selection -->
            <div class="form-group mb-3">
                <label class="form-label">Genres</label>
                <div class="border p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                    @{
                        var genres = ViewBag.Genres as SelectList;
                        if (genres != null)
                        {
                            @foreach (var genre in genres)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="selectedGenres" value="@genre.Value" class="form-check-input" id="genre_@genre.Value" />
                                    <label class="form-check-label" for="genre_@genre.Value">
                                        @genre.Text
                                    </label>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
            <a asp-controller="Genres" asp-action="Create" class="btn btn-success mb-3" target="_blank">Create New Genre</a>

            <!-- Submit Button -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

