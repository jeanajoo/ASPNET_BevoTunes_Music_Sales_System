@model G6_BevoTunes.Models.Album

@{
    ViewData["Title"] = "Create Album";
}

<h1>Create Album</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <!-- Album Name -->
            <div class="form-group mb-3">
                <label asp-for="AlbumName" class="form-label"></label>
                <input asp-for="AlbumName" class="form-control" />
                <span asp-validation-for="AlbumName" class="text-danger"></span>
            </div>

            <!-- Album Price -->
            <div class="form-group mb-3">
                <label asp-for="AlbumPrice" class="form-label"></label>
                <input asp-for="AlbumPrice" class="form-control" step="0.01" type="number" />
                <span asp-validation-for="AlbumPrice" class="text-danger"></span>
            </div>

            <!-- Album Cover URL -->
            <div class="form-group mb-3">
                <label asp-for="AlbumCover" class="form-label"></label>
                <input asp-for="AlbumCover" class="form-control" />
                <span asp-validation-for="AlbumCover" class="text-danger"></span>
                <small class="form-text text-muted">Enter a valid URL for the album cover image</small>
            </div>

            <!-- Artists Selection -->
            <div class="form-group mb-3">
                <label class="form-label">Artists</label>
                <div class="border p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                    @{
                        var artists = ViewBag.Artists as SelectList;
                        if (artists != null)
                        {
                            @foreach (var artist in artists)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="selectedArtists" value="@artist.Value" class="form-check-input artist-checkbox" id="artist_@artist.Value" />
                                    <label class="form-check-label" for="artist_@artist.Value">
                                        @artist.Text
                                    </label>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <!-- Genres Selection -->
            <div class="form-group mb-3">
                <label class="form-label">Genres (Optional)</label>
                <div class="border p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                    @{
                        var genres = ViewBag.Genres as SelectList;
                        if (genres != null)
                        {
                            @foreach (var genre in genres)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="selectedGenres" value="@genre.Value" class="form-check-input" id="genre_@genre.Value" />
                                    <label class="form-check-label" for="genre_@genre.Value">
                                        @genre.Text
                                    </label>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
            <a asp-controller="Genres" asp-action="Create" class="btn btn-success">Create Genre</a>

            <!-- Songs Selection -->
            <div class="form-group mb-3">
                <label class="form-label">Songs from Selected Artists</label>
                <div class="border p-3 rounded" style="max-height: 200px; overflow-y: auto;" id="songsContainer">
                    <p class="text-muted">Select artists above to populate songs list</p>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-controller ="Search" asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const artistCheckboxes = document.querySelectorAll('.artist-checkbox');
            const songsContainer = document.getElementById('songsContainer');

            // Add change event listeners to artist checkboxes
            artistCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', updateSongs);
            });

            async function updateSongs() {
                // Get all selected artist IDs
                const selectedArtists = Array.from(artistCheckboxes)
                    .filter(cb => cb.checked)
                    .map(cb => cb.value);

                if (selectedArtists.length === 0) {
                    songsContainer.innerHTML = '<p class="text-muted">Select artists above to populate songs list</p>';
                    return;
                }

                try {
                    // Build query string for artist IDs
                    const queryString = selectedArtists.map(id => `artistIds=${id}`).join('&');
                    
                    const response = await fetch(`/Albums/GetSongsByArtists?${queryString}`);
                    const songs = await response.json();

                    if (songs.length === 0) {
                        songsContainer.innerHTML = '<p class="text-muted">No songs found for selected artists</p>';
                        return;
                    }

                    // Generate HTML for songs checkboxes
                    let html = '';
                    songs.forEach(song => {
                        html += `
                            <div class="form-check">
                                <input type="checkbox" name="selectedSongs" value="${song.id}" class="form-check-input" id="song_${song.id}" />
                                <label class="form-check-label" for="song_${song.id}">
                                    ${song.name}
                                </label>
                            </div>
                        `;
                    });
                    songsContainer.innerHTML = html;
                } catch (error) {
                    console.error('Error fetching songs:', error);
                    songsContainer.innerHTML = '<p class="text-danger">Error loading songs. Please try again.</p>';
                }
            }
        });
    </script>
}

