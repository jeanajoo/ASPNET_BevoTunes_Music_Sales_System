@model G6_BevoTunes.Models.Album

@{
    ViewData["Title"] = "Details";
}

<h1>@Model.AlbumName</h1>

<div class="container-fluid">
    <div class="row">
        <!-- Left Container: Album Cover and Songs -->
        <div class="col-md-6">
            <!-- Album Cover -->
            <div class="mb-4">
                <img src="@Model.AlbumCover" alt="@Model.AlbumName" class="img-fluid rounded" style="max-width: 100%;">
            </div>

            <!-- Songs List -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Songs</h5>
                </div>
                <div class="card-body">
                    @if (Model.Songs != null && Model.Songs.Count > 0)
                    {
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Song Title</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var song in Model.Songs)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Products" asp-action="SongDetails" asp-route-id="@song.SongId">
                                                @song.SongTitle
                                            </a>
                                        </td>
                                        <td>@song.SongPrice.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No songs available for this album.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Right Container: Album Details and Reviews -->
        <div class="col-md-6">
            <!-- Album Details -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Album Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Album Name</dt>
                        <dd class="col-sm-8">@Model.AlbumName</dd>

                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8">@Model.AlbumPrice.ToString("C")</dd>

                        <dt class="col-sm-4">Rating</dt>
                            @if (Model.AverageRating == -1.0m)
                            {
                                <dd class="col-sm-8">
                                    Not Rated Yet
                                </dd>
                            }
                            else
                            {
                                <dd class="col-sm-8">
                                    @Model.AverageRating / 5.0
                                </dd>
                            }
                    </dl>

                    <!-- Artists -->
                    <div class="mt-3">
                        <h6>Artists</h6>
                        @if (Model.Artists != null && Model.Artists.Count > 0)
                        {
                            <ul class="list-inline">
                                @foreach (var artist in Model.Artists)
                                {
                                    if (artist == Model.Artists.Last())
                                    {
                                        <a asp-controller="Artists" asp-action="Details" asp-route-id="@artist.ArtistId">
                                            @artist.ArtistName
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Artists" asp-action="Details" asp-route-id="@artist.ArtistId">
                                            @artist.ArtistName,
                                        </a>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No artists available.</p>
                        }
                    </div>

                    <!-- Genres -->
                    <div class="mt-3">
                        <h6>Genres</h6>
                        @if (Model.Genres != null && Model.Genres.Count > 0)
                        {
                            <ul class="list-inline">
                                @foreach (var genre in Model.Genres)
                                {
                                    if (genre == Model.Genres.Last())
                                    {
                                        <span>@genre.GenreName</span>
                                    }
                                    else
                                    {
                                        <span>@genre.GenreName, </span>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No genres available.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Reviews -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Reviews</h5>
                </div>
                <div class="card-body">
                    @if (Model.Reviews != null && Model.Reviews.Count > 0)
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            @if (review.Status.ToString() == "Approve")
                            {
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="card-subtitle text-muted">@review.Reviewer?.UserName</h6>
                                                <div class="mt-2">
                                                    @for (int i = 0; i < review.Rating; i++)
                                                    {
                                                        <span class="text-warning">★</span>
                                                    }
                                                    @for (int i = review.Rating; i < 5; i++)
                                                    {
                                                        <span class="text-muted">★</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <p class="card-text mt-2">@review.Description</p>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p class="text-muted">No approved reviews yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.AlbumId" class="btn btn-warning">Edit</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to Albums</a>
</div>
